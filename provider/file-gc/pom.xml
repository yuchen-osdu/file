<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.opengroup.osdu</groupId>
    <artifactId>os-file</artifactId>
    <version>0.30.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>file-gc</artifactId>
  <packaging>jar</packaging>

  <name>file-gc</name>
  <description>Google Cloud implementation of File service APIs for Datastore</description>

  <properties>
    <spring-boot.repackage.skip>false</spring-boot.repackage.skip>
  </properties>

  <dependencies>

    <dependency>
      <groupId>org.opengroup.osdu</groupId>
      <artifactId>file-core-plus</artifactId>
      <version>0.30.0-SNAPSHOT</version>
    </dependency>
    <!--
      The root pom excludes spring-boot-starter-tomcat from the managed
      spring-boot-starter-web entry, which also strips tomcat-embed-core
      (and therefore jakarta.servlet-api). The GC provider runs an embedded
      Tomcat, so re-introduce the starter explicitly here.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-tomcat</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>spring-boot</classifier>
          <mainClass>org.springframework.boot.loader.launch.PropertiesLauncher</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
